# 1Password references for signing and notarization (no secrets here).
# Usage: op run --env-file scripts/signing.env -- scripts/sign-macos.sh
# Same credentials Ace uses for desktop releases.
DEVELOPER_ID=op://Dev/Ace desktop releases/ACE_CODESIGN_IDENTITY
APPLE_API_KEY_ID=op://Dev/Ace desktop releases/ACE_NOTARY_KEY_ID
APPLE_API_ISSUER=op://Dev/Ace desktop releases/ACE_NOTARY_ISSUER
APPLE_API_PRIVATE_KEY=op://Dev/Ace desktop releases/ACE_NOTARY_PRIVATE_KEY
